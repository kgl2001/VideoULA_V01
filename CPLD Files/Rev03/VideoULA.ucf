# VideoULA V01 Rev03 - pin assignments (XC9572XL-VQ44)
# Derived from the KiCad schematic for hardware Rev03.
# The Rev03 pinout is identical to Rev04.
# CLK_6M: drives the SAA5050 in the 48MHz build only (high-Z in the 16MHz build).
NET "A"  LOC = "P2"  ;
NET "B"  LOC = "P12"  ;
NET "B_IN"  LOC = "P8"  ;
NET "CLK_1M"  LOC = "P43"  ;
NET "CLK_2M"  LOC = "P41"  ;
NET "CLK_4M"  LOC = "P42"  ;
NET "CLK_6M"  LOC = "P3"  ;
NET "CLK_8M"  LOC = "P40"  ;
NET "CLK_CRTC"  LOC = "P36"  ;
NET "CLK_IN"  LOC = "P44"  ;
NET "CURSOR"  LOC = "P31"  ;
NET "D<0>"  LOC = "P20"  ;
NET "D<1>"  LOC = "P21"  ;
NET "D<2>"  LOC = "P22"  ;
NET "D<3>"  LOC = "P23"  ;
NET "D<4>"  LOC = "P27"  ;
NET "D<5>"  LOC = "P28"  ;
NET "D<6>"  LOC = "P32"  ;
NET "D<7>"  LOC = "P33"  ;
NET "DISEN"  LOC = "P30"  ;
NET "G"  LOC = "P14"  ;
NET "G_IN"  LOC = "P13"  ;
NET "R"  LOC = "P19"  ;
NET "R_IN"  LOC = "P18"  ;
NET "SRAM_ADDR<0>"  LOC = "P7"  ;
NET "SRAM_ADDR<1>"  LOC = "P6"  ;
NET "SRAM_ADDR<2>"  LOC = "P5"  ;
NET "SRAM_ADDR<3>"  LOC = "P16"  ;
NET "SRAM_DATA<0>"  LOC = "P29"  ;
NET "SRAM_DATA<1>"  LOC = "P34"  ;
NET "SRAM_DATA<2>"  LOC = "P37"  ;
NET "SRAM_DATA<3>"  LOC = "P38"  ;
NET "SRAM_nWE"  LOC = "P39"  ;
NET "nCS"  LOC = "P1"  ;
